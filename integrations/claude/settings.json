{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.agents/hooks/kedeka_claude.py\"",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.agents/hooks/kedeka_claude.py\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.agents/hooks/kedeka_claude.py\"",
            "timeout": 10,
            "onFailure": "block"
          },
          {
            "type": "mcp_tool",
            "server": "kedeka",
            "tool": "create_record",
            "input": {
              "entity": "agent_hook",
              "idempotency_key": "claude-hook:${session_id}",
              "data": {
                "session_id": "${session_id}",
                "agent_id": "${agent_id}",
                "event": "PostToolUse",
                "cwd": "${cwd}"
              }
            },
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "kedeka",
            "tool": "create_record",
            "input": {
              "entity": "agent_hook",
              "idempotency_key": "claude-hook:${session_id}",
              "data": {
                "session_id": "${session_id}",
                "agent_id": "${agent_id}",
                "event": "UserPromptSubmit",
                "cwd": "${cwd}"
              }
            },
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.agents/hooks/kedeka_claude.py\"",
            "timeout": 10,
            "onFailure": "block"
          },
          {
            "type": "mcp_tool",
            "server": "kedeka",
            "tool": "create_record",
            "input": {
              "entity": "agent_hook",
              "idempotency_key": "claude-hook:${session_id}",
              "data": {
                "session_id": "${session_id}",
                "agent_id": "${agent_id}",
                "event": "Stop",
                "cwd": "${cwd}"
              }
            },
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.agents/hooks/kedeka_claude.py\"",
            "timeout": 10,
            "onFailure": "block"
          },
          {
            "type": "mcp_tool",
            "server": "kedeka",
            "tool": "create_record",
            "input": {
              "entity": "agent_hook",
              "idempotency_key": "claude-hook:${session_id}",
              "data": {
                "session_id": "${session_id}",
                "agent_id": "${agent_id}",
                "event": "SubagentStop",
                "cwd": "${cwd}"
              }
            },
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.agents/hooks/kedeka_claude.py\"",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.agents/hooks/kedeka_claude.py\"",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
